/ {
    behaviors {
        // Create different mouse behaviors with processors baked in
        mms: mouse_move_slow {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            processors = <&mouse_slow 0 0>;
        };
        
        mmf: mouse_move_fast {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            processors = <&mouse_fast 0 0>;
        };
        
        mmw: mouse_move_warp {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            processors = <&mouse_warp 0 0>;
        };
    };
};
